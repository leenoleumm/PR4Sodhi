<Page x:Class="Практическая_работа_4_Соди.Page3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      Title="Страница 3">

    <ScrollViewer>
        <StackPanel Margin="20" HorizontalAlignment="Center" Width="550">

            <TextBlock Text="Страница 3: Табуляция и график" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <Image Source="Images/img3.png" Height="100" Width="400" HorizontalAlignment="Center" Margin="0,0,0,15" Stretch="Uniform"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                <TextBlock Text="x0 =" Width="50" VerticalAlignment="Center" FontSize="14"/>
                <TextBox x:Name="txtX0" Width="100" FontSize="14" Margin="0,0,20,0"/>
                <TextBlock Text="xk =" Width="50" VerticalAlignment="Center" FontSize="14"/>
                <TextBox x:Name="txtXk" Width="100" FontSize="14"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                <TextBlock Text="dx =" Width="50" VerticalAlignment="Center" FontSize="14"/>
                <TextBox x:Name="txtDx" Width="100" FontSize="14" Margin="0,0,20,0"/>
                <TextBlock Text="b =" Width="50" VerticalAlignment="Center" FontSize="14"/>
                <TextBox x:Name="txtB" Width="100" FontSize="14"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15">
                <TextBlock Text="Результат:" Width="80" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
            </StackPanel>

            <TextBox x:Name="txtResult" IsReadOnly="True" TextWrapping="Wrap" Height="150" Width="450" 
                     FontSize="12" VerticalScrollBarVisibility="Auto" Margin="0,5,0,10"/>

            <TextBlock Text="График функции y(x)" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,5"/>

            <lvc:CartesianChart x:Name="chart" Height="250" Width="450" Margin="0,0,0,15">
                <lvc:CartesianChart.Series>
                    <lvc:LineSeries x:Name="lineSeries" Title="y = f(x)" StrokeThickness="2" PointGeometrySize="5"/>
                </lvc:CartesianChart.Series>
            </lvc:CartesianChart>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                <Button x:Name="btnCalc" Content="Вычислить" Width="100" Margin="0,0,10,0" Click="BtnCalc_Click" FontSize="14" Padding="5"/>
                <Button x:Name="btnClear" Content="Очистить" Width="100" Click="BtnClear_Click" FontSize="14" Padding="5"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>