<Page x:Class="Практическая_работа_4_Соди.Page2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Страница 2">

    <ScrollViewer>
        <StackPanel Margin="20" HorizontalAlignment="Center" Width="450">

            <TextBlock Text="Страница 2: Расчёт l" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <Image Source="Images/img2.png" Height="120" Width="400" HorizontalAlignment="Center" Margin="0,0,0,15" Stretch="Uniform"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                <TextBlock Text="x =" Width="50" VerticalAlignment="Center" FontSize="14"/>
                <TextBox x:Name="txtX" Width="150" FontSize="14"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                <TextBlock Text="p =" Width="50" VerticalAlignment="Center" FontSize="14"/>
                <TextBox x:Name="txtP" Width="150" FontSize="14"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15">
                <TextBlock Text="Выберите f(x):" VerticalAlignment="Center" FontSize="14" Margin="0,0,10,0"/>
                <RadioButton x:Name="rbSh" Content="sh(x)" GroupName="FuncGroup" Margin="0,0,10,0" IsChecked="True"/>
                <RadioButton x:Name="rbX2" Content="x²" GroupName="FuncGroup" Margin="0,0,10,0"/>
                <RadioButton x:Name="rbExp" Content="eˣ" GroupName="FuncGroup"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15">
                <TextBlock Text="Результат:" Width="80" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                <TextBox x:Name="txtResult" IsReadOnly="True" Background="LightGray" Width="150" FontSize="14"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                <Button x:Name="btnCalc" Content="Вычислить" Width="100" Margin="0,0,10,0" Click="BtnCalc_Click" FontSize="14" Padding="5"/>
                <Button x:Name="btnClear" Content="Очистить" Width="100" Click="BtnClear_Click" FontSize="14" Padding="5"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>