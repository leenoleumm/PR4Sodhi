<Window x:Class="Практическая_работа_4_Соди.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Практическая работа 4 Соди"
        Height="600" Width="800">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10" Height="40">
            <Button x:Name="btnPage1" Content="Страница 1" Width="120" Margin="5" Click="BtnPage1_Click"/>
            <Button x:Name="btnPage2" Content="Страница 2" Width="120" Margin="5" Click="BtnPage2_Click"/>
            <Button x:Name="btnPage3" Content="Страница 3" Width="120" Margin="5" Click="BtnPage3_Click"/>
        </StackPanel>
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
    </DockPanel>
</Window>